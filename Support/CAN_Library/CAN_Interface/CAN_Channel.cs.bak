        public void set_SingleWireHighVoltage(uint id, bool isSingleWireHighVoltage)
        {
            if (CAN_Matrix.Any(p => p.ID == id))
            {
                CAN_Matrix.First(p => p.ID == id).isSingleWireHighVoltage = isSingleWireHighVoltage;
            }
        }

