<UserControl x:Class="AIclient.DeviceSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AIclient">
  <UserControl.Resources>
    <Style x:Key="Field" TargetType="StackPanel"><Setter Property="Width" Value="170"/><Setter Property="Margin" Value="0,0,16,12"/></Style>
    <Style x:Key="BindingTable" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
      <Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="VerticalAlignment" Value="Center"/></Style></Style.Resources>
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="Foreground" Value="#E8EEF8"/><Setter Property="Background" Value="#101B2B"/><Setter Property="RowBackground" Value="#172438"/><Setter Property="AlternatingRowBackground" Value="#1B2B41"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="44"/><Setter Property="MinHeight" Value="125"/><Setter Property="MaxHeight" Value="220"/><Setter Property="Margin" Value="0,8,0,14"/>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Expander x:Name="SerialExpander" Header="串口设置" IsExpanded="True" Margin="0,0,0,18">
      <StackPanel Margin="12,10,12,0">
        <DataGrid x:Name="SerialGrid" Style="{StaticResource BindingTable}" SelectionChanged="SerialSelected">
          <DataGrid.Columns>
            <DataGridTextColumn Header="通道" Binding="{Binding Name}" Width="150"/>
            <DataGridTextColumn Header="串口" Binding="{Binding Port}" Width="150"/>
            <DataGridTextColumn Header="波特率" Binding="{Binding BaudRate}" Width="*"/>
            <DataGridTemplateColumn Header="操作" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="解绑" Click="UnbindSerialClick" Padding="12,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,0,0,14"><TextBlock Text="可用串口" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="SerialAvailableBox" Width="180" IsEditable="False" Margin="0,0,8,0"/><Button Content="刷新" Tag="scan-serial" Click="ActionClick"/><Button x:Name="BindSerialButton" Content="绑定通道" Click="BindSerialClick"/><Button Content="新增通道" Click="AddSerialClick"/></WrapPanel>
        <StackPanel x:Name="SerialEditor" Visibility="Collapsed">
          <WrapPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="波特率" Margin="0,0,0,6"/><ComboBox x:Name="SerialBaudBox" IsEditable="False" SelectedItem="{Binding BaudRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="数据位" Margin="0,0,0,6"/><ComboBox x:Name="SerialDataBox" SelectedItem="{Binding DataBits}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="校验" Margin="0,0,0,6"/><ComboBox x:Name="SerialParityBox" SelectedItem="{Binding Parity}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="停止位" Margin="0,0,0,6"/><ComboBox x:Name="SerialStopBox" SelectedItem="{Binding StopBits}"/></StackPanel>
            <CheckBox Content="启用此通道" IsChecked="{Binding Enabled}" Margin="0,0,0,12"/>
          </WrapPanel>
          <Expander Header="更多参数" Margin="0,0,0,12"><WrapPanel Margin="0,10,0,0">
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="通道名称"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" LostFocus="SerialDetailsChanged"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="编码"/><TextBox Text="{Binding Encoding, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="换行"/><TextBox Text="{Binding NewLine, Converter={x:Static local:DeviceSettingsView.EscapedNewLine}, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
          </WrapPanel></Expander>
        </StackPanel>
      </StackPanel>
    </Expander>
    <Expander x:Name="PowerExpander" Header="电源设置" Margin="0,0,0,18">
      <StackPanel Margin="12,10,12,0">
        <DataGrid x:Name="PowerBindingsGrid" Style="{StaticResource BindingTable}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="用途" Binding="{Binding Purpose}" Width="150"/>
            <DataGridTextColumn Header="设备" Binding="{Binding Device}" Width="*"/>
            <DataGridTemplateColumn Header="操作" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="解绑" Tag="{Binding Key}" Click="UnbindPowerClick" Padding="12,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,0,0,12"><TextBlock Text="设备类型" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="PowerTransportBox" Width="150" SelectedValuePath="Value" SelectedValue="{Binding Power.Transport}" SelectionChanged="PowerTransportChanged" Margin="0,0,16,0"/><CheckBox x:Name="PowerEnabledToggle" Content="启用电源" IsChecked="{Binding Power.Enabled}"/></WrapPanel>
        <WrapPanel Margin="0,0,0,14"><TextBlock Text="可用设备" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="PowerAvailableBox" Width="360" IsEditable="False" Margin="0,0,8,0"/><Button Content="刷新" Click="ScanPowerClick"/><Button x:Name="BindPowerButton" Content="绑定为电源" Tag="supply" Click="BindPowerClick"/><Button x:Name="BindMeterButton" Content="绑定为测量仪" Tag="meter" Click="BindPowerClick"/></WrapPanel>
        <Expander Header="高级参数" Margin="0,0,0,12"><StackPanel Margin="0,12,0,0">
          <WrapPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="最低电压（V）"/><TextBox Text="{Binding Power.MinVoltage, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="最高电压（V）"/><TextBox Text="{Binding Power.MaxVoltage, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="超时（ms）"/><TextBox Text="{Binding Power.TimeoutMs, ValidatesOnExceptions=True}"/></StackPanel>
          </WrapPanel>
          <WrapPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="输出开启命令"/><TextBox Text="{Binding Power.OnCommand}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="输出关闭命令"/><TextBox Text="{Binding Power.OffCommand}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="设压命令"/><TextBox Text="{Binding Power.VoltageCommand}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="电压回读命令"/><TextBox Text="{Binding Power.VoltageQuery}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="电流回读命令"/><TextBox Text="{Binding Power.CurrentQuery}"/></StackPanel>
          </WrapPanel>
        </StackPanel></Expander>
        <Expander Header="手动控制"><WrapPanel Margin="0,12,0,12"><Button Content="输出开启" Tag="power-on" Click="ActionClick"/><Button Content="输出关闭" Tag="power-off" Click="ActionClick"/><TextBox x:Name="ManualVoltageBox" Text="12" Width="80" Margin="0,0,8,0"/><Button Content="设置电压" Tag="power-set" Click="ActionClick"/><Button Content="读取电压" Tag="power-voltage" Click="ActionClick"/><Button Content="读取电流" Tag="power-current" Click="ActionClick"/></WrapPanel></Expander>
      </StackPanel>
    </Expander>
    <Expander x:Name="BusExpander" Header="总线设置" Margin="0,0,0,18">
      <StackPanel Margin="12,10,12,0">
        <WrapPanel>
          <StackPanel Style="{StaticResource Field}"><TextBlock Text="设备类型" Margin="0,0,0,6"/><ComboBox x:Name="AdapterBox" SelectedValuePath="Value" SelectedValue="{Binding Bus.Adapter}" SelectionChanged="BusTypeChanged"/></StackPanel>
          <StackPanel Style="{StaticResource Field}"><TextBlock Text="总线协议" Margin="0,0,0,6"/><ComboBox x:Name="ProtocolBox" SelectedItem="{Binding Bus.Protocol}" SelectionChanged="ProtocolChanged"/></StackPanel>
          <CheckBox x:Name="BusEnabledToggle" Content="启用总线" IsChecked="{Binding Bus.Enabled}" Margin="0,0,0,12"/>
        </WrapPanel>
        <DataGrid x:Name="BusBindingsGrid" Style="{StaticResource BindingTable}" MinHeight="85">
          <DataGrid.Columns><DataGridTextColumn Header="通道" Binding="{Binding Purpose}" Width="150"/><DataGridTextColumn Header="设备" Binding="{Binding Device}" Width="*"/><DataGridTemplateColumn Header="操作" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="解绑" Click="UnbindBusClick" Padding="12,4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
        </DataGrid>
        <WrapPanel Margin="0,0,0,14"><TextBlock Text="可用设备" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="BusAvailableBox" Width="360" IsEditable="False" Margin="0,0,8,0"/><Button Content="刷新" Click="ScanBusClick"/><Button x:Name="BindBusButton" Content="绑定通道" Click="BindBusClick"/></WrapPanel>
        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DatabaseLabel" Text="数据库" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="DatabaseBox" Grid.Column="1" Text="{Binding Bus.DbcPath, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="2" Content="浏览…" Click="BrowseDatabaseClick" Margin="8,0,0,0"/></Grid>
        <WrapPanel x:Name="CanOptions"><StackPanel Style="{StaticResource Field}"><TextBlock Text="波特率（bit/s）" Margin="0,0,0,6"/><ComboBox x:Name="CanBaudBox" IsEditable="False" SelectedItem="{Binding Bus.BitRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel x:Name="FdOptions" Style="{StaticResource Field}"><TextBlock Text="数据速率（bit/s）" Margin="0,0,0,6"/><ComboBox x:Name="FdBaudBox" IsEditable="False" SelectedItem="{Binding Bus.DataRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></WrapPanel>
        <WrapPanel x:Name="LinOptions" Visibility="Collapsed"><StackPanel Style="{StaticResource Field}"><TextBlock Text="波特率" Margin="0,0,0,6"/><ComboBox x:Name="LinBaudBox" SelectedItem="{Binding Bus.LinBaud}"/></StackPanel><StackPanel Style="{StaticResource Field}"><TextBlock Text="LIN 版本" Margin="0,0,0,6"/><ComboBox x:Name="LinVersionBox" SelectedItem="{Binding Bus.LinVersion}"/></StackPanel><CheckBox Content="主节点" IsChecked="{Binding Bus.LinMaster}" Margin="0,0,0,12"/></WrapPanel>
        <WrapPanel x:Name="FlexRayOptions" Visibility="Collapsed"><StackPanel Style="{StaticResource Field}"><TextBlock Text="E-Ray 启动帧" Margin="0,0,0,6"/><TextBox Text="{Binding Bus.ErayFrame}"/></StackPanel><StackPanel Style="{StaticResource Field}"><TextBlock Text="Cold 启动帧" Margin="0,0,0,6"/><TextBox Text="{Binding Bus.ColdFrame}"/></StackPanel></WrapPanel>
        <Expander Header="高级参数"><StackPanel Margin="0,12,0,0">
          <WrapPanel><StackPanel Style="{StaticResource Field}"><TextBlock Text="节点 / ECU 名称"/><TextBox Text="{Binding Bus.NodeName}"/></StackPanel><StackPanel x:Name="SlcanOptions" Style="{StaticResource Field}"><TextBlock Text="设备串口波特率"/><TextBox Text="{Binding Bus.Serial.BaudRate, ValidatesOnExceptions=True}"/></StackPanel></WrapPanel>
          <StackPanel x:Name="TimingOptions"><CheckBox Content="自定义 CAN 位时序" IsChecked="{Binding Bus.Timing.Enabled}" Margin="0,0,0,12"/><WrapPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="时钟 MHz"/><TextBox Text="{Binding Bus.Timing.ClockMHz, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="仲裁 BRP"/><TextBox Text="{Binding Bus.Timing.ArbitrationBrp, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="仲裁 TSEG1"/><TextBox Text="{Binding Bus.Timing.ArbitrationTseg1, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="仲裁 TSEG2"/><TextBox Text="{Binding Bus.Timing.ArbitrationTseg2, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="仲裁 SJW"/><TextBox Text="{Binding Bus.Timing.ArbitrationSjw, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="数据 BRP"/><TextBox Text="{Binding Bus.Timing.DataBrp, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="数据 TSEG1"/><TextBox Text="{Binding Bus.Timing.DataTseg1, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="数据 TSEG2"/><TextBox Text="{Binding Bus.Timing.DataTseg2, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Style="{StaticResource Field}"><TextBlock Text="数据 SJW"/><TextBox Text="{Binding Bus.Timing.DataSjw, ValidatesOnExceptions=True}"/></StackPanel>
          </WrapPanel></StackPanel>
        </StackPanel></Expander>
      </StackPanel>
    </Expander>
    <Expander x:Name="CommandsExpander" Header="高级：设备命令" Margin="0,0,0,18"><StackPanel Margin="12,10,12,0">
      <DataGrid x:Name="CommandsGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MinHeight="130" MaxHeight="240" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
        <DataGridTextColumn Header="名称" Binding="{Binding Alias}" Width="130"/><DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="180"/><DataGridComboBoxColumn Header="类型" x:Name="CommandTransportColumn" SelectedItemBinding="{Binding Transport}" ElementStyle="{StaticResource GridComboDisplay}" Width="85"/><DataGridTextColumn Header="通道" Binding="{Binding Channel}" Width="110"/><DataGridTextColumn Header="发送内容" Binding="{Binding Payload}" Width="170"/><DataGridCheckBoxColumn Header="HEX" Binding="{Binding Hex}"/><DataGridTextColumn Header="报文 ID" Binding="{Binding FrameId}" Width="85"/><DataGridTextColumn Header="帧名" Binding="{Binding FrameName}" Width="120"/>
      </DataGrid.Columns></DataGrid><Button Content="发送选中命令" Tag="send-alias" Click="ActionClick" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </StackPanel></Expander>
    <WrapPanel><Button Content="保存设置" Tag="save" Click="ActionClick" Background="#207F70"/><Button Content="连接检查" Tag="preflight" Click="ActionClick"/><TextBlock x:Name="DeviceMessage" TextWrapping="Wrap" MaxWidth="720" VerticalAlignment="Center"/></WrapPanel>
  </StackPanel>
</UserControl>
