<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0105;CS0168;CS0169;CS0219;CS0414;CS0649;CS0067;CS0618;CS1717;CS0659;CS0661;CS0675;CS1696;CS1570;CS1572;CS1573;CS1587;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="vxlapi_NET"><HintPath>../../../Support/CAN_Library/dll/vxlapi_NET.dll</HintPath></Reference>
    <Compile Include="../../../Support/CAN_Library/**/*.cs" Exclude="../../../Support/CAN_Library/Properties/**;../../../Support/CAN_Library/Log.cs;../../../Support/CAN_Library/CAN_Interface/CAN_Channel.cs;../../../Support/CAN_Library/obj/**;../../../Support/CAN_Library/bin/**" LinkBase="Legacy" />
    <Content Include="../../../Support/CAN_Library/dll/**/*.dll" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../Support/CAN_Library/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PrepareLegacyChannel" BeforeTargets="CoreCompile">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../scripts/Prepare-LegacySource.ps1&quot; -Source &quot;$(MSBuildProjectDirectory)/../../../Support/CAN_Library/CAN_Interface/CAN_Channel.cs&quot; -Output &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)LegacyChannel.cs&quot;" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)LegacyChannel.cs" /></ItemGroup>
  </Target>
</Project>
